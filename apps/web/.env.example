# Copy to .env.local (gitignored). Every variable, with where to get it.

# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → publishable key (sb_publishable_…).
# The legacy "anon" JWT also works. Safe to expose to browsers; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard → Project Settings → API Keys → secret key (sb_secret_…; legacy "service_role").
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS. Read only by lib/push.ts, for its one write to
# another user's profile: nulling a push token that Expo reports as DeviceNotRegistered. Without it, sends
# still work, but a dead token is retried on every admin action until the app re-registers; the case is logged
# as "SUPABASE_SERVICE_ROLE_KEY missing?".
SUPABASE_SERVICE_ROLE_KEY=

# expo.dev → Account settings → Access tokens. Read by lib/push.ts when sending. Optional: leave empty unless
# "Enhanced push security" is enabled on the Expo project, in which case Expo rejects sends without it.
EXPO_ACCESS_TOKEN=
