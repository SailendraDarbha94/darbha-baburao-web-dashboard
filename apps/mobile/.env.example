# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* variables into the app bundle at build/start time.

# Supabase dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → publishable key (sb_publishable_…). Never the secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the web app, which hosts the API route handlers.
# iOS simulator: http://localhost:3000. Physical device on the same Wi-Fi: http://<your-mac-lan-ip>:3000
# (a development build also reads this file: `expo start` serves its JavaScript).
# Preview/production builds: the Vercel URL, set per profile in eas.json.
EXPO_PUBLIC_API_URL=http://localhost:3000
