# dependencies / caches
node_modules/
.turbo/
.next/
.expo/
dist/
web-build/
.metro-health-check*
*.tsbuildinfo

# generated by the frameworks on every run; never hand-edited
apps/web/next-env.d.ts
apps/mobile/expo-env.d.ts

# env: examples are committed, real values never
.env
.env.*
!.env.example

# Expo continuous native generation output (expo run:*, expo prebuild); the project stays managed
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.kotlin/
apps/mobile/google-services.json
*.orig.*

# signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Supabase CLI local state
packages/supabase/.temp/
packages/supabase/.branches/
packages/.supabase/

# deploy
.vercel
# EAS build output (`eas build --local` writes build-<timestamp>.ipa/.apk/.aab/.tar.gz into apps/mobile)
*.ipa
*.apk
*.aab
apps/mobile/build-*.tar.gz

# per-developer tool settings
.claude/settings.local.json
.claude/launch.json

# OS / editor
.DS_Store
*.log
